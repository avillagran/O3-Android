    <string name="general_text_0" formatted="false">12 ساعة</string>
    <string name="general_text_1" formatted="false">24 ساعة</string>
    <string name="general_text_2" formatted="false">السماح لجلسات الوكيل الجديدة بتشغيل الأجهزة المحلية والبعيدة والتحكم بها مع إعداد الأدوات تلقائيًا.</string>
    <string name="general_text_3" formatted="false">تُضاف إلى موجّه العناوين الجديدة والمعاد إنشاؤها.</string>
    <string name="general_text_4" formatted="false">قبول التعديلات</string>
    <string name="general_text_5" formatted="false">الإغلاق بعد عدم النشاط (أيام)</string>
    <string name="general_text_6" formatted="false">تلقائي</string>
    <string name="general_text_7" formatted="false">يرتّب سلاسل المحادثات تلقائيًا بعد دمج طلبات السحب المرتبطة بها.</string>
    <string name="general_text_8" formatted="false">يرتّب سلاسل المحادثات تلقائيًا بعد هذا العدد من أيام الخمول.</string>
    <string name="general_text_9" formatted="false">النشاط في الخلفية</string>
    <string name="general_text_10" formatted="false">يوازن بين التحديث في الخلفية والأداء واستهلاك البطارية.</string>
    <string name="general_text_11" formatted="false">متوازن</string>
    <string name="general_text_12" formatted="false">توفير البطارية</string>
    <string name="general_text_13" formatted="false">قبل انتهاء الذاكرة المؤقتة (تجريبي)</string>
    <string name="general_text_14" formatted="false">بادئة اسم الفرع</string>
    <string name="general_text_15" formatted="false">تسمية الفروع</string>
    <string name="general_text_16" formatted="false">تعليمات تسمية الفروع</string>
    <string name="general_text_17" formatted="false">يتحقق من تحديثات المزوّدين المثبتين في الخلفية.</string>
    <string name="general_text_18" formatted="false">التحقق من تحديثات المزودين</string>
    <string name="general_text_19" formatted="false">اختر طريقة تسمية الفروع المنشأة لأشجار العمل الجديدة.</string>
    <string name="general_text_20" formatted="false">اختر وقت ظهور الردود أثناء عمل الوكيل.</string>
    <string name="general_text_21" formatted="false">ضغط المحادثات الخاملة</string>
    <string name="general_text_22" formatted="false">يواصل سلاسل المحادثات النشطة بعد إعادة تشغيل الخادم للتحديث.</string>
    <string name="general_text_23" formatted="false">التزامات وفق القواعد</string>
    <string name="general_text_24" formatted="false">نسخة العمل الحالية</string>
    <string name="general_text_25" formatted="false">مخصص</string>
    <string name="general_text_26" formatted="false">النموذج الافتراضي لسلاسل المحادثات الجديدة. يمكن للمشاريع تجاوزه.</string>
    <string name="general_text_27" formatted="false">الأذونات الافتراضية لسلاسل المحادثات الجديدة. يمكن للمشاريع تجاوزها.</string>
    <string name="general_text_28" formatted="false">تفعيل أدلة المراجعة</string>
