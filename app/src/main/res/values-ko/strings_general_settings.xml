<resources>
    <string name="general_text_0" formatted="false">12시간</string>
    <string name="general_text_1" formatted="false">24시간</string>
    <string name="general_text_2" formatted="false">새 에이전트 세션에서 필요한 도구를 자동으로 설정하여 로컬 및 원격 기기를 시작하고 제어할 수 있습니다.</string>
    <string name="general_text_3" formatted="false">새 스레드 제목과 다시 생성되는 제목의 프롬프트에 추가됩니다.</string>
    <string name="general_text_4" formatted="false">편집 자동 승인</string>
    <string name="general_text_5" formatted="false">비활성 후 완료 처리 (일)</string>
    <string name="general_text_6" formatted="false">자동</string>
    <string name="general_text_7" formatted="false">연결된 풀 리퀘스트가 병합되면 스레드를 자동으로 정리합니다.</string>
    <string name="general_text_8" formatted="false">지정한 일수 동안 활동이 없으면 스레드를 자동으로 정리합니다.</string>
    <string name="general_text_9" formatted="false">백그라운드 활동</string>
    <string name="general_text_10" formatted="false">백그라운드 새로 고침과 성능 및 배터리 사용량의 균형을 맞춥니다.</string>
    <string name="general_text_11" formatted="false">균형</string>
    <string name="general_text_12" formatted="false">배터리 절약</string>
    <string name="general_text_13" formatted="false">캐시 만료 전(베타)</string>
    <string name="general_text_14" formatted="false">브랜치 이름 접두사</string>
    <string name="general_text_15" formatted="false">브랜치 이름 지정</string>
    <string name="general_text_16" formatted="false">브랜치 이름 지정 지침</string>
    <string name="general_text_17" formatted="false">설치된 공급자의 업데이트를 백그라운드에서 확인합니다.</string>
    <string name="general_text_18" formatted="false">제공자 업데이트 확인</string>
    <string name="general_text_19" formatted="false">새 작업 트리용으로 생성되는 브랜치의 이름 지정 방식을 선택합니다.</string>
    <string name="general_text_20" formatted="false">에이전트가 작업하는 동안 응답을 표시할 시점을 선택합니다.</string>
    <string name="general_text_21" formatted="false">유휴 스레드 압축</string>
    <string name="general_text_22" formatted="false">업데이트를 위한 서버 재시작 후 활성 스레드를 계속 진행합니다.</string>
    <string name="general_text_23" formatted="false">규약에 따른 커밋</string>
    <string name="general_text_24" formatted="false">현재 작업 복사본</string>
    <string name="general_text_25" formatted="false">사용자 지정</string>
    <string name="general_text_26" formatted="false">새 스레드의 기본 모델입니다. 프로젝트에서 재정의할 수 있습니다.</string>
    <string name="general_text_27" formatted="false">새 스레드의 기본 권한입니다. 프로젝트에서 재정의할 수 있습니다.</string>
    <string name="general_text_28" formatted="false">검토 가이드 활성화</string>
    <string name="general_text_29" formatted="false">풀 리퀘스트 템플릿 따르기</string>
    <string name="general_text_30" formatted="false">후속 메시지 동작</string>
    <string name="general_text_31" formatted="false">전체 액세스</string>
    <string name="general_settings_title" formatted="false">일반</string>
    <string name="general_text_33" formatted="false">새 작업 트리에서 git 하위 모듈을 채우는 방식입니다. 프로젝트에서 재정의할 수 있습니다.</string>
    <string name="general_text_34" formatted="false">상속</string>
    <string name="general_text_35" formatted="false">환경에서 상속됨</string>
    <string name="general_text_36" formatted="false">작업 트리 브랜치 이름 생성을 위한 지침입니다.</string>
    <string name="general_text_37" formatted="false">열린 풀 리퀘스트가 있는 스레드는 자동 정리 대상에서 제외합니다.</string>
    <string name="general_text_38" formatted="false">풀 리퀘스트가 있는 대화 유지</string>
    <string name="general_text_39" formatted="false">제목은 몇 단어로. 핵심 주제로 시작.</string>
    <string name="general_text_40" formatted="false">작업 복사본에 로컬 변경 사항이나 커밋이 없으면 기본 브랜치를 최신으로 유지합니다. 프로젝트에서 재정의할 수 있습니다.</string>
    <string name="general_text_41" formatted="false">언어</string>
    <string name="general_text_42" formatted="false">마지막 사용</string>
    <string name="general_text_43" formatted="false">지역 설정</string>
    <string name="general_text_44" formatted="false">로그 엔드포인트</string>
    <string name="general_text_45" formatted="false">병합</string>
    <string name="general_text_46" formatted="false">메트릭 엔드포인트</string>
    <string name="general_text_47" formatted="false">서로 다른 출처</string>
    <string name="general_text_48" formatted="false">서로 다른 값</string>
    <string name="general_text_49" formatted="false">모델</string>
    <string name="general_text_50" formatted="false">제목과 기타 텍스트 생성에 사용하는 모델입니다.</string>
    <string name="general_text_51" formatted="false">풀 리퀘스트 검토 가이드를 생성하는 모델입니다.</string>
    <string name="general_text_52" formatted="false">커밋 및 풀 리퀘스트 메시지를 작성하는 모델입니다.</string>
    <string name="general_text_53" formatted="false">사용량 제한으로 중단된 스레드를 초기화 시각까지 Snoozed로 옮깁니다. 자동 재개와 함께 사용하면 이후 깨워서 계속 진행합니다.</string>
    <string name="general_text_54" formatted="false">안 함</string>
    <string name="general_text_55" formatted="false">새 작업 트리</string>
    <string name="general_text_56" formatted="false">없음</string>
    <string name="general_text_57" formatted="false">끔</string>
    <string name="general_text_58" formatted="false">켬</string>
    <string name="general_text_59" formatted="false">문단</string>
    <string name="general_text_60" formatted="false">성능</string>
    <string name="general_text_61" formatted="false">권한</string>
    <string name="general_text_62" formatted="false">계획 모드(기존)</string>
    <string name="general_text_63" formatted="false">자동 생성되는 작업 트리 브랜치 이름에 추가할 접두사입니다.</string>
    <string name="general_text_64" formatted="false">프로젝트 재정의</string>
    <string name="general_text_65" formatted="false">변경 사항 자동 가져오기</string>
    <string name="general_text_66" formatted="false">풀 리퀘스트 병합 방식</string>
    <string name="general_text_67" formatted="false">풀 리퀘스트는 먼저 이 방법을 사용합니다. \'마지막 사용\'은 이 기기에서 최근 선택한 방법을 다시 사용합니다.</string>
    <string name="general_text_68" formatted="false">대기열로</string>
    <string name="general_text_69" formatted="false">빠른 답변</string>
    <string name="general_text_70" formatted="false">리베이스</string>
    <string name="general_text_71" formatted="false">재귀적</string>
    <string name="general_text_72" formatted="false">새로 고침</string>
    <string name="general_text_73" formatted="false">병합 시 에이전트 크레딧 제거</string>
    <string name="general_text_74" formatted="false">병합 메시지에서 확인된 에이전트 기여 표시를 제거하고 사람 공동 작성자는 유지합니다.</string>
    <string name="general_text_75" formatted="false">저장소 규칙</string>
    <string name="general_text_76" formatted="false">초기화</string>
    <string name="general_text_77" formatted="false">응답 스트리밍</string>
    <string name="general_text_78" formatted="false">결과를 알 수 없습니다. 다시 시도하기 전에 새로고침하세요.</string>
    <string name="general_text_79" formatted="false">서버 업데이트 후 재개</string>
    <string name="general_text_80" formatted="false">사용량 제한 대화 자동 재개</string>
    <string name="general_text_81" formatted="false">사용량 제한으로 중단된 스레드를 안내된 초기화 시각에 다시 시작합니다. 각 스레드에서 예약된 재개를 취소할 수 있습니다.</string>
    <string name="general_text_82" formatted="false">검토 가이드 지침</string>
    <string name="general_text_83" formatted="false">검토 가이드 모델</string>
    <string name="general_text_84" formatted="false">저장</string>
    <string name="general_text_85" formatted="false">저장됨</string>
    <string name="general_text_86" formatted="false">의미 기반</string>
    <string name="general_text_87" formatted="false">트레이스, 메트릭, 로그를 OTLP HTTP 수신기로 보냅니다. 적용하려면 서버를 다시 시작하세요.</string>
    <string name="general_text_88" formatted="false">병합된 풀 리퀘스트 대화 완료</string>
    <string name="general_text_89" formatted="false">사용량 제한 대화 미루기</string>
    <string name="general_text_90" formatted="false">버전 관리 문구 작성 모델</string>
    <string name="general_text_91" formatted="false">커밋 합치기</string>
    <string name="general_text_92" formatted="false">새 worktree를 origin에서 시작</string>
    <string name="general_text_93" formatted="false">사용할 수 있다면 원격 기본 브랜치에서 새 작업 트리를 시작합니다.</string>
    <string name="general_text_94" formatted="false">정적</string>
    <string name="general_text_95" formatted="false">방향 전환</string>
    <string name="general_text_96" formatted="false">감독 모드</string>
    <string name="general_text_97" formatted="false">텍스트 생성 모델</string>
    <string name="general_text_98" formatted="false">이 기기</string>
    <string name="general_text_99" formatted="false">스레드 제목 지침</string>
    <string name="general_text_100" formatted="false">시간 형식</string>
    <string name="general_text_101" formatted="false">최상위</string>
    <string name="general_text_102" formatted="false">트레이스 엔드포인트</string>
    <string name="general_text_103" formatted="false">턴</string>
    <string name="general_text_104" formatted="false">사용 불가</string>
    <string name="general_text_105" formatted="false">상속된 값 사용</string>
    <string name="general_text_106" formatted="false">200,000 토큰이 넘는 유휴 Claude 스레드를 압축할 시점: 돌아왔을 때, 프롬프트 캐시가 만료되기 직전, 또는 안 함. 각 Claude 공급자가 재정의할 수 있습니다.</string>
    <string name="general_text_107" formatted="false">돌아왔을 때</string>
    <string name="general_text_108" formatted="false">새 스레드가 시작되는 위치입니다. 프로젝트와 해당 t3.json 파일에서 재정의할 수 있습니다.</string>
    <string name="general_text_109" formatted="false">작업 공간</string>
    <string name="general_text_110" formatted="false">worktree 하위 모듈</string>
    <string name="general_text_111" formatted="false">작성 지침</string>
    <string name="general_text_112" formatted="false">작성 스타일</string>
    <string name="general_text_113" formatted="false">기본</string>
    <string name="general_text_114" formatted="false">worktree</string>
</resources>
