#!/usr/bin/env python3
"""Convert Omarchy's themes into app/src/main/assets/themes/omarchy-themes.json.

Contract: docs/ui/omarchy-themes.md; role list and alphas: docs/ui/tokens.md section 1.
Python 3.11+ standard library only, no network.

    tools/import-omarchy-themes [THEMES_DIR] [--output FILE] [--omarchy-version V]

THEMES_DIR defaults to /usr/share/omarchy/themes. The Omarchy version is read from
THEMES_DIR/../version unless given. Exits non-zero on a missing required key, an
unparsable value or a `mode` that disagrees with the background's luminance.

Rerunning on unchanged themes rewrites nothing: `generatedAt` is kept from the existing
file while the themes and the Omarchy version are the same.
"""

import argparse
import datetime
import json
import re
import sys
import tomllib
from fractions import Fraction
from pathlib import Path

SCHEMA = 1
DEFAULT_THEMES_DIR = Path("/usr/share/omarchy/themes")
DEFAULT_OUTPUT = Path(__file__).resolve().parent.parent / "app/src/main/assets/themes/omarchy-themes.json"

# ot3's colors.toml rule (ot3:ui/qml/T3Palette.qml:26): quoted six-digit hex only.
VALUE = re.compile(r"""^\s*([a-zA-Z0-9_]+)\s*=\s*["'](#[0-9a-fA-F]{6})["']""")
ASSIGNMENT = re.compile(r"^\s*([a-zA-Z0-9_]+)\s*=")

# Required keys and the Omarchy fallback each one has (omarchy:shell/Commons/Color.qml:159-164).
REQUIRED = {"background": "color0", "foreground": "color7", "accent": "color4", "red": "color1"}

# Output key -> colors.toml key, in output order.
BASE_KEYS = [
    ("background", "background"), ("foreground", "foreground"), ("accent", "accent"), ("muted", "muted"),
    ("red", "red"), ("orange", "orange"), ("yellow", "yellow"), ("green", "green"), ("cyan", "cyan"),
    ("blue", "blue"), ("magenta", "magenta"), ("brightBlue", "bright_blue"), ("brightMagenta", "bright_magenta"),
]

# ot3's project slot order (ot3:ui/qml/T3Palette.qml:17-22).
PROJECT_KEYS = ["blue", "green", "magenta", "cyan", "orange", "yellow", "red", "bright_blue", "bright_magenta"]

# Sky header constants per appearance (ot3:ui/qml/T3Panel.qml:1125-1126, ot3:ui/qml/T3Starfield.qml:59-63).
SKY = {
    "dark": {"lightSky": False, "brightness": 1.25, "nebula": 0.55, "meteorRate": 0.85, "ink": 1.0},
    "light": {"lightSky": True, "brightness": 0.9, "nebula": 0.55, "meteorRate": 0.85, "ink": 1.7},
}


class ThemeError(Exception):
    pass


def parse_hex(value):
    return tuple(int(value[i:i + 2], 16) for i in (1, 3, 5))


def to_hex(rgb):
    return "#" + "".join(f"{c:02x}" for c in rgb)


def composite(top, bottom, alpha):
    """Straight sRGB alpha compositing of `top` at `alpha` (a decimal string) over `bottom`.

    Exact rational arithmetic, then round half to even: two goldens in tokens.md
    (tokyo-night divider, catppuccin-latte rowSelected) are exact ties.
    """
    a = Fraction(alpha)
    t, b = parse_hex(top), parse_hex(bottom)
    return to_hex(tuple(round(bc + (tc - bc) * a) for tc, bc in zip(t, b)))


def relative_luminance(value):
    """WCAG 2 relative luminance, for the onAccent contrast check."""
    def linear(c):
        c = c / 255
        return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4
    r, g, b = (linear(c) for c in parse_hex(value))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast(a, b):
    la, lb = sorted((relative_luminance(a), relative_luminance(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)


def is_light(background):
    """ot3's sky rule: Rec.709 weights on the encoded channels, > 0.5 (ot3:ui/qml/T3Starfield.qml:58)."""
    r, g, b = (c / 255 for c in parse_hex(background))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.5


def read_colors(path):
    """Returns (values, mode). Values are the keys ot3's regex accepts, lowercased hex."""
    text = path.read_text(encoding="utf-8")
    try:
        mode = tomllib.loads(text).get("mode")
    except tomllib.TOMLDecodeError as error:
        raise ThemeError(f"{path}: not valid TOML: {error}") from error
    values, malformed = {}, set()
    for line in text.splitlines():
        match = VALUE.match(line)
        if match:
            values[match.group(1)] = match.group(2).lower()
        else:
            assigned = ASSIGNMENT.match(line)
            if assigned:
                malformed.add(assigned.group(1))
    for key, fallback in REQUIRED.items():
        for name in (key, fallback):
            if name in malformed and name not in values:
                raise ThemeError(f"{path}: `{name}` is not a quoted six-digit hex colour")
    return values, mode


def title_case(theme_id):
    return " ".join(part[:1].upper() + part[1:] for part in theme_id.split("-"))


def build_theme(theme_dir):
    theme_id = theme_dir.name
    values, mode = read_colors(theme_dir / "colors.toml")

    resolved = dict(values)
    for key, fallback in REQUIRED.items():
        if key not in resolved:
            if fallback not in values:
                raise ThemeError(f"{theme_id}: missing required key `{key}` (and `{fallback}`)")
            resolved[key] = values[fallback]
    if "muted" not in resolved:
        resolved["muted"] = values.get("color8", resolved["foreground"])

    bg, fg, accent = resolved["background"], resolved["foreground"], resolved["accent"]
    appearance = "light" if is_light(bg) else "dark"
    if mode is not None and mode != appearance:
        raise ThemeError(f"{theme_id}: mode = {mode!r} but the background's Rec.709 luminance says {appearance}")

    def pick(key, fallback):
        return resolved.get(key, fallback)

    failed = resolved["red"]
    # ot3 always uses the background (`highlightedText`, ot3:ui/qml/T3Panel.qml:386). The
    # foreground replaces it only when it is under 4.5:1 and the foreground is better; for
    # every Omarchy 4.0.2 theme the background wins (docs/DECISIONS.md, 2026-10-25).
    on_accent = bg
    if contrast(accent, bg) < 4.5 and contrast(accent, fg) > contrast(accent, bg):
        on_accent = fg

    def over_bg(colour, alpha):
        return composite(colour, bg, alpha)

    roles = {
        "dim": over_bg(fg, "0.57"),
        "divider": over_bg(fg, "0.09"),
        "surface": over_bg(fg, "0.045"),
        "card": over_bg(fg, "0.035"),
        "cardBorder": over_bg(fg, "0.12"),
        "changesCard": over_bg(fg, "0.025"),
        "rowSelected": over_bg(fg, "0.075"),
        "rowPressed": over_bg(fg, "0.045"),
        "rowDraft": over_bg(accent, "0.06"),
        "field": over_bg(fg, "0.04"),
        "fieldBorder": over_bg(fg, "0.14"),
        "switchOff": over_bg(fg, "0.15"),
        "inlineCode": over_bg(fg, "0.10"),
        "composerFocus": over_bg(accent, "0.45"),
        "accentContainer": over_bg(accent, "0.14"),
        "failedContainer": over_bg(failed, "0.14"),
        "working": pick("blue", accent),
        "done": pick("green", accent),
        "waiting": pick("yellow", accent),
        "failed": failed,
        "warning": pick("orange", pick("yellow", accent)),
        "input": pick("magenta", accent),
        "onAccent": on_accent,
    }

    # A missing key falls back to the accent, as ot3's pick() does; duplicates are dropped.
    palette = []
    for key in PROJECT_KEYS:
        colour = pick(key, accent)
        if colour not in palette:
            palette.append(colour)

    return {
        "id": theme_id,
        "name": title_case(theme_id),
        "appearance": appearance,
        "base": {out: resolved[key] for out, key in BASE_KEYS if key in resolved},
        "roles": roles,
        "projectPalette": palette,
        "sky": dict(SKY[appearance]),
    }


def read_version(themes_dir, explicit):
    if explicit:
        return explicit
    version_file = themes_dir.parent / "version"
    if version_file.is_file():
        return version_file.read_text(encoding="utf-8").strip()
    raise ThemeError(f"no {version_file}; pass --omarchy-version")


def generate(themes_dir, output, version, generated_at=None):
    theme_dirs = sorted(d for d in themes_dir.iterdir() if (d / "colors.toml").is_file())
    if not theme_dirs:
        raise ThemeError(f"{themes_dir}: no <theme>/colors.toml")
    themes = [build_theme(d) for d in theme_dirs]

    if generated_at is None:
        generated_at = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        if output.is_file():
            try:
                previous = json.loads(output.read_text(encoding="utf-8"))
                if previous.get("themes") == themes and previous.get("source", {}).get("omarchyVersion") == version:
                    generated_at = previous["source"]["generatedAt"]
            except (ValueError, KeyError, AttributeError):
                pass

    document = {
        "schema": SCHEMA,
        "source": {"omarchyVersion": version, "generatedAt": generated_at},
        "themes": themes,
    }
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(document, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    return themes


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("themes_dir", nargs="?", type=Path, default=DEFAULT_THEMES_DIR)
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    parser.add_argument("--omarchy-version")
    parser.add_argument("--generated-at", help="ISO-8601 UTC timestamp to write instead of now")
    args = parser.parse_args(argv)
    try:
        version = read_version(args.themes_dir, args.omarchy_version)
        themes = generate(args.themes_dir, args.output, version, args.generated_at)
    except (ThemeError, OSError) as error:
        print(f"import-omarchy-themes: {error}", file=sys.stderr)
        return 1
    dark = sum(t["appearance"] == "dark" for t in themes)
    print(f"{len(themes)} themes ({dark} dark, {len(themes) - dark} light) from Omarchy {version} -> {args.output}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
