#!/usr/bin/env -S python3 -I
"""Import ot3's strings into Android resources.

Reads app/src/main/res/ot3-strings.tsv (android_name<TAB>ot3 English key), looks
every key up in ot3's translations/i18n.json for all of its locales and writes
values/strings_ot3.xml plus values-<locale>/strings_ot3.xml. Rules:
docs/ui/strings.md, "Generator".

    tools/import-ot3-strings [--ot3 DIR] [--check]

--ot3 defaults to $OT3_CHECKOUT, then ../omarchy-t3-code-ref next to this
repository. --check writes nothing and fails if any output would change.
Standard library only; run with python3 -I because the catalog comes from
another checkout.
"""

import argparse
import hashlib
import json
import os
import re
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
RES = REPO / "app" / "src" / "main" / "res"
TSV = RES / "ot3-strings.tsv"
OUTPUT_NAME = "strings_ot3.xml"
# Files the importer never writes; names in them must not collide with ours.
HAND_WRITTEN = (RES / "values" / "strings.xml", RES / "values" / "strings_mobile.xml")

# ot3's 20 locales (ot3:translations/COVERAGE.md:6-25), in ot3's order.
LOCALES = ("en", "es", "pt", "fr", "de", "it", "nl", "pl", "ru", "uk",
           "ja", "ko", "zh", "ar", "tr", "sv", "da", "no", "fi", "cs")
# Android resource qualifier per ot3 locale; Norwegian Bokmål is "nb" on Android.
QUALIFIER = {"en": None, "no": "nb"}
RTL_LOCALES = ("ar",)

NAME = re.compile(r"[a-z][a-z0-9_]*\Z")
PLACEHOLDER = re.compile(r"\{([A-Za-z_][A-Za-z0-9_]*)\}")


class CatalogError(Exception):
    pass


def read_rows(path):
    rows, seen = [], {}
    for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        if not line.strip() or line.startswith("#"):
            continue
        parts = line.split("\t")
        if len(parts) != 2 or not parts[1]:
            raise CatalogError(f"{path.name}:{number}: expected android_name<TAB>ot3 English key")
        name, key = parts
        if not NAME.match(name):
            raise CatalogError(f"{path.name}:{number}: invalid Android resource name {name!r}")
        if name in seen:
            raise CatalogError(f"{path.name}:{number}: {name} already defined on line {seen[name]}")
        seen[name] = number
        rows.append((name, key))
    return rows


def hand_written_names():
    names = set()
    for path in HAND_WRITTEN:
        if path.exists():
            names.update(re.findall(r'<string\s+name="([^"]+)"', path.read_text(encoding="utf-8")))
    return names


def placeholder_order(english):
    order = []
    for match in PLACEHOLDER.finditer(english):
        if match.group(1) not in order:
            order.append(match.group(1))
    return order


def escape_literal(text, formatted):
    out = []
    for ch in text:
        if ch == "\\":
            out.append("\\\\")
        elif ch == "\n":
            out.append("\\n")
        elif ch == "\t":
            out.append("\\t")
        elif ch in "'\"@?":
            out.append("\\" + ch)
        elif ch == "&":
            out.append("&amp;")
        elif ch == "<":
            out.append("&lt;")
        elif ch == ">":
            out.append("&gt;")
        elif ch == "%" and formatted:
            out.append("%%")
        else:
            out.append(ch)
    return "".join(out)


def keep_spaces(value):
    # aapt2 collapses runs of whitespace and trims the ends; keep ot3's spacing.
    value = re.sub(r"(?<= ) ", r"\\u0020", value)
    if value.startswith(" "):
        value = "\\u0020" + value[1:]
    if value.endswith(" "):
        value = value[:-1] + "\\u0020"
    return value


def to_android(text, order):
    """ot3 text with {name} placeholders → escaped Android string with %n$s."""
    formatted = bool(order)
    out, last = [], 0
    for match in PLACEHOLDER.finditer(text):
        out.append(escape_literal(text[last:match.start()], formatted))
        out.append(f"%{order.index(match.group(1)) + 1}$s")
        last = match.end()
    out.append(escape_literal(text[last:], formatted))
    return keep_spaces("".join(out))


def render(locale, rows, catalog, digest):
    lines = ['<?xml version="1.0" encoding="utf-8"?>',
             f"<!-- Generated by tools/import-ot3-strings from ot3:translations/i18n.json "
             f"(sha256 {digest}), locale \"{locale}\".",
             "     Do not edit: add rows to app/src/main/res/ot3-strings.tsv and run the importer again."]
    if locale != "en":
        lines.append("     ot3's non-English values are machine-authored drafts (ot3:translations/COVERAGE.md:27).")
    if locale in RTL_LOCALES:
        lines.append("     RTL: right-to-left locale; layouts using these strings need an RTL review.")
    lines[-1] += " -->"
    lines.append("<resources>")
    english = catalog["en"]
    for name, key in rows:
        order = placeholder_order(english[key])
        text = catalog[locale][key]
        value = to_android(text, order)
        extra = ' formatted="false"' if not order and "%" in text else ""
        lines.append(f'    <string name="{name}"{extra}>{value}</string>')
    lines.append("</resources>")
    return "\n".join(lines) + "\n"


def validate(rows, catalog):
    problems = []
    missing_locales = [locale for locale in LOCALES if locale not in catalog]
    if missing_locales:
        raise CatalogError(f"i18n.json lacks locales: {', '.join(missing_locales)}")
    taken = hand_written_names()
    for name, key in rows:
        if name in taken:
            problems.append(f"{name}: already defined in strings.xml or strings_mobile.xml")
        if key not in catalog["en"]:
            problems.append(f"{name}: key not in ot3's catalog: {key!r}")
            continue
        expected = set(placeholder_order(catalog["en"][key]))
        for locale in LOCALES:
            text = catalog[locale].get(key)
            if not isinstance(text, str) or not text.strip():
                problems.append(f"{name}: no {locale} translation for {key!r}")
            elif set(PLACEHOLDER.findall(text)) != expected:
                problems.append(f"{name}: {locale} placeholders {sorted(set(PLACEHOLDER.findall(text)))} "
                                f"differ from English {sorted(expected)}")
    if problems:
        raise CatalogError("\n".join(problems))


def output_path(locale):
    qualifier = QUALIFIER.get(locale, locale)
    folder = "values" if qualifier is None else f"values-{qualifier}"
    return RES / folder / OUTPUT_NAME


def find_ot3(argument):
    candidates = [argument] if argument else [os.environ.get("OT3_CHECKOUT"), REPO.parent / "omarchy-t3-code-ref"]
    for candidate in candidates:
        if candidate and (Path(candidate) / "translations" / "i18n.json").is_file():
            return Path(candidate)
    raise CatalogError("ot3 checkout not found: pass --ot3 DIR or set OT3_CHECKOUT "
                       "(a checkout of omarchy-t3-code at the pin in docs/UI_SPEC.md section 0)")


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--ot3", help="ot3 (omarchy-t3-code) checkout")
    parser.add_argument("--check", action="store_true", help="fail if any output would change; write nothing")
    args = parser.parse_args(argv)
    try:
        catalog_path = find_ot3(args.ot3) / "translations" / "i18n.json"
        raw = catalog_path.read_bytes()
        catalog = json.loads(raw)
        rows = read_rows(TSV)
        validate(rows, catalog)
    except CatalogError as error:
        print(f"import-ot3-strings: {error}", file=sys.stderr)
        return 1
    digest = hashlib.sha256(raw).hexdigest()
    stale = []
    for locale in LOCALES:
        path = output_path(locale)
        content = render(locale, rows, catalog, digest)
        current = path.read_text(encoding="utf-8") if path.exists() else None
        if current == content:
            continue
        if args.check:
            stale.append(str(path.relative_to(REPO)))
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(content, encoding="utf-8")
    if stale:
        print("import-ot3-strings: out of date:\n  " + "\n  ".join(stale), file=sys.stderr)
        return 1
    print(f"import-ot3-strings: {len(rows)} strings × {len(LOCALES)} locales")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
